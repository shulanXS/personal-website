# Cloudflare Pages redirects.
#
# The standalone tag pages were removed — the tags now live on the search
# page, where a click searches all four collections at once. The old URLs are
# redirected so that links from elsewhere keep working.
/tags/*  /search  301
/about   /  301

# Notes have no page of their own: they live on the /notes/ listing and are
# expanded in place. Old links to a single note land on the listing.
/notes/* /notes  301

# The archives page was removed — the listing pages replace it.
/archives /posts  301
