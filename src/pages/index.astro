---
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import MonogramLogo from "@/assets/monogram-logo.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import PostCard from "@/components/PostCard.astro";
import NoteEntry from "@/components/NoteEntry.astro";
import WritingCard from "@/components/WritingCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ActivityEntry from "@/components/ActivityEntry.astro";
import {
  getPublishedNotes,
  getPublishedPosts,
  getPublishedWriting,
} from "@/utils/content";
import { getProjectsByDate } from "@/utils/getProjects";
import { routeUrl } from "@/utils/routes";
import { getRecentActivity } from "@/utils/activity";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(config.site.uiLang);

/*
 * The wide layout.
 *
 * The home page has two faces. On a wide screen it keeps the four kinds of
 * content in four sections, each one showing the latest of its kind.
 *
 * On a narrow screen it becomes a single column, and a single column of
 * four separate sections is four things to scroll through. There the four
 * kinds are merged into one timeline instead, so that the whole of what
 * the site holds is read as one sequence of things that happened.
 *
 * Every list below is ordered by the moment its entries happened. A new
 * note, article, chapter or project therefore moves straight to the top
 * of its own section, with nothing arranged by hand.
 */
const notes = await getPublishedNotes();
const posts = await getPublishedPosts();
const writing = await getPublishedWriting();
const projects = getProjectsByDate();

/*
 * The timeline of the narrow layout.
 */
const activity = await getRecentActivity(locale, config.home.activityLimit);

const homePath = routeUrl(locale, "home");
---

<Layout width="wide">
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- Hero -->
    <section id="hero" class="border-border border-b pt-10 pb-10">
      <div
        class="grid grid-cols-1 gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-center lg:grid-cols-[minmax(0,1fr)_auto]"
      >
        <div class="max-w-2xl">
          {
            /*
            The identity line comes first and in a smaller, wider-tracked
            style: it frames the name that follows and gives the visitor an
            immediate sense of who the site belongs to.
          */
          }
          <p
            class="text-muted-foreground flex items-center gap-2 text-sm font-medium tracking-[0.18em] uppercase"
            data-i18n="home.identity"
          >
            <span
              class="bg-accent inline-block size-1.5 shrink-0 rounded-full"
              aria-hidden="true"></span>
            {t.home.identity}
          </p>

          <h1 class="mt-4 text-4xl font-bold sm:text-5xl">
            <span
              class="text-muted-foreground mr-2 text-2xl font-normal sm:text-3xl"
              data-i18n="home.greeting"
            >
              {t.home.greeting}
            </span>
            <span data-i18n="site.name">{t.site.name}</span>
          </h1>

          <p class="mt-5 text-lg leading-relaxed" data-i18n="home.intro">
            {t.home.intro}
          </p>

          <p
            class="text-muted-foreground mt-3 leading-relaxed"
            data-i18n="home.about"
          >
            {t.home.about}
          </p>

          <p
            class="text-accent mt-5 text-sm font-medium tracking-wide"
            data-i18n="home.keywords"
          >
            {t.home.keywords}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3">
            {
              socials.length > 0 && (
                <div class="flex max-w-full min-w-0 items-center">
                  <Socials align="start" size="md" />
                </div>
              )
            }
          </div>
        </div>

        {
          /*
          The logo doubles as the portrait of the site: the geometric
          monogram of the author's name, drawn in the same thin, single
          colour as the mark in the header.

          It is large enough to hold its own against the text column beside
          it, and it is centred against that column rather than pinned to
          its top, so that the two halves of the hero read as one balanced
          pair instead of a headline with an ornament hanging off it.

          Behind it sits a very faint halo — neutral, like the mark itself
          — so that the figure sits on the page instead of floating in
          front of it. The halo is drawn inside the padding of the box
          rather than outside it: a negative margin would push it past the
          edge of the viewport on a narrow screen, and the page would
          scroll sideways.
        */
        }
        <div class="relative hidden shrink-0 p-6 md:block lg:p-10">
          <div
            class="pointer-events-none absolute inset-0 rounded-full"
            style="background: radial-gradient(circle at 50% 45%, color-mix(in oklab, var(--foreground) 7%, transparent), transparent 68%);"
            aria-hidden="true"
          >
          </div>
          <MonogramLogo
            class="text-foreground relative size-32 shrink-0 opacity-80 lg:size-56"
            aria-hidden="true"
          />
        </div>
      </div>
    </section>

    <!--
      The wide layout.

      The home page keeps the four kinds of content in four sections, each
      one showing the latest of its kind. Every section is ordered by the
      moment its entries happened, so a new note, a new article, a new
      chapter or a new project moves straight to the top of its own
      section — nothing here is arranged by hand.

      The four sections are *not* four equal blocks of a grid. The page is
      one continuous flow of text, and the sections are laid out along it
      in two columns that are independent of each other: the notes and
      the articles on the top row, the projects and the literary works on
      the bottom one.

      The two columns are independent rather than being the two halves of
      one grid, and that is the whole point. A grid makes its rows as tall
      as their tallest cell, so a section of three long notes would leave
      a hole under the articles beside it — a hole big enough to read as
      a mistake. Two columns, each of which simply stacks its own two
      sections, have no holes: the projects begin where the notes end, and
      the literary works begin where the articles end.

      The two columns are not of equal width either, and they are not
      equal because the two kinds of thing they hold want different
      amounts of room. The left column holds the notes and the projects:
      a note is a paragraph of text, and a project is a card with a
      picture of itself in it. Both want width. The right column holds
      the articles and the literary works, and both of those are lists of
      *references* — a title, a day, a set of tags — which say everything
      they have to say in a narrow column. A third of the page would do
      for them, and giving them more would only stretch them out.

      Each section carries a "see everything" link of its own, so that a
      section reads as a window onto a collection rather than as the whole
      of it. The four big buttons at the foot of the page are the other
      way in, and the two sets would say the same thing twice.

      It is hidden on a narrow screen, where the timeline below takes its
      place.
    -->
    <div
      class="hidden lg:grid lg:grid-cols-[1.75fr_1fr] lg:items-start lg:gap-x-14"
    >
      <!--
      The left column: the notes, and the projects below them.
      -->
      <div class="min-w-0">
        {
          /*
          The notes come first: they are the most personal and the most
          frequently updated part of the site, so they should be visible
          without scrolling.
        */
        }
        {
          notes.length > 0 && (
            <section id="recent-notes" class="pt-12 pb-6">
              <div class="app-section-head">
                <h2
                  class="text-xl font-semibold tracking-wide"
                  data-i18n="home.recentNotes"
                >
                  {t.home.recentNotes}
                </h2>
                <a
                  href={routeUrl(locale, "notes")}
                  class="app-section-more"
                  data-i18n="home.allNotes"
                >
                  {t.home.allNotes}
                  <IconArrowRight class="inline-block rtl:-rotate-180" />
                </a>
              </div>
              <ul class="mt-5" data-list-layout="notes" data-notes-wall>
                {notes.slice(0, config.home.recentNotes).map(note => (
                  <li>
                    <NoteEntry note={note} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Recent projects -->
        {
          projects.length > 0 && (
            <section id="recent-projects" class="pt-12 pb-6">
              <div class="app-section-head">
                <h2
                  class="text-xl font-semibold tracking-wide"
                  data-i18n="home.featuredProjects"
                >
                  {t.home.featuredProjects}
                </h2>
                <a
                  href={routeUrl(locale, "projects")}
                  class="app-section-more"
                  data-i18n="home.allProjects"
                >
                  {t.home.allProjects}
                  <IconArrowRight class="inline-block rtl:-rotate-180" />
                </a>
              </div>
              {/*
              Two projects side by side, at the size they are on the
              project page.

              A project is an object: it has a picture of itself, a name
              and a description, and the picture is what tells two
              projects apart at a glance. The left column is wide enough
              to carry that picture properly, so the cards here are the
              same cards as on the project page — the picture across the
              top, the name and the description under it — rather than a
              shrunken version of them.

              The picture is the one thing that is scaled down: a card
              this wide would not need a picture six hundred pixels wide,
              and a smaller one keeps the pair of them from turning the
              section into a wall of images.
              */}
              <ul class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
                {projects.slice(0, config.home.recentProjects).map(project => (
                  <ProjectCard project={project} variant="compact" />
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <!--
      The right column: the articles, and the literary works below them.
      -->
      <div class="min-w-0">
        <!-- Recent posts -->
        {
          posts.length > 0 && (
            <section id="recent-posts" class="pt-12 pb-6">
              <div class="app-section-head">
                <h2
                  class="text-xl font-semibold tracking-wide"
                  data-i18n="home.recentPosts"
                >
                  {t.home.recentPosts}
                </h2>
                <a
                  href={routeUrl(locale, "posts")}
                  class="app-section-more"
                  data-i18n="home.allPosts"
                >
                  {t.home.allPosts}
                  <IconArrowRight class="inline-block rtl:-rotate-180" />
                </a>
              </div>
              {/*
              The articles are a plain list of references: a title, the day
              it was written and the tags it carries. There is no rule above
              the list and none between its entries — a hairline here would
              draw a box around the section and make it read as a widget
              rather than as part of the page.
              */}
              <ul class="mt-5" data-list-layout="vertical">
                {posts.slice(0, config.home.recentPosts).map(post => (
                  <PostCard post={post} variant="compact" />
                ))}
              </ul>
            </section>
          )
        }

        <!-- Recent writing -->
        {
          writing.length > 0 && (
            <section id="recent-writing" class="pt-12 pb-6">
              <div class="app-section-head">
                <h2
                  class="text-xl font-semibold tracking-wide"
                  data-i18n="home.recentWriting"
                >
                  {t.home.recentWriting}
                </h2>
                <a
                  href={routeUrl(locale, "writing")}
                  class="app-section-more"
                  data-i18n="home.allWriting"
                >
                  {t.home.allWriting}
                  <IconArrowRight class="inline-block rtl:-rotate-180" />
                </a>
              </div>
              {/*
              The works are a list of titles. There is no summary beside
              them: a chapter's own line about itself is on its page, and
              the section is a reference to the works rather than an
              introduction to them.
              */}
              <ul class="mt-5" data-list-layout="writing">
                {writing.slice(0, config.home.recentWriting).map(work => (
                  <WritingCard work={work} variant="compact" />
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>

    <!--
      The narrow layout.

      Everything the site holds is merged into one list here and ordered by
      the moment it happened, so that the home page reads as a running
      account of the site rather than as four separate sections.

      It is shown on a narrow screen only; the wide layout above takes
      over from `lg` upwards.
    -->
    <section id="activity" class="pt-12 pb-6 lg:hidden">
      <div class="max-w-app-flow mx-auto">
        <h2
          class="text-2xl font-semibold tracking-wide"
          data-i18n="home.activity"
        >
          {t.home.activity}
        </h2>
        <p
          class="text-muted-foreground mt-2 text-sm"
          data-i18n="home.activityDesc"
        >
          {t.home.activityDesc}
        </p>

        {
          activity.length > 0 ? (
            <ul class="mt-6" data-list-layout="activity">
              {activity.map(entry => (
                <ActivityEntry entry={entry} />
              ))}
            </ul>
          ) : (
            <p
              class="text-muted-foreground mt-6"
              data-i18n="home.activityEmpty"
            >
              {t.home.activityEmpty}
            </p>
          )
        }
      </div>
    </section>

    <div class="my-8 flex flex-wrap justify-center gap-4 text-center">
      <LinkButton href={routeUrl(locale, "notes")}>
        <span data-i18n="home.allNotes">{t.home.allNotes}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={routeUrl(locale, "posts")}>
        <span data-i18n="home.allPosts">{t.home.allPosts}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={routeUrl(locale, "writing")}>
        <span data-i18n="home.allWriting">{t.home.allWriting}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={routeUrl(locale, "projects")}>
        <span data-i18n="home.allProjects">{t.home.allProjects}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
