---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import SlothLogo from "@/assets/sloth-logo.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import PostCard from "@/components/PostCard.astro";
import NoteCard from "@/components/NoteCard.astro";
import WritingCard from "@/components/WritingCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import {
  getPublishedNotes,
  getPublishedPosts,
  getPublishedWriting,
} from "@/utils/content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getFeaturedProjects } from "@/utils/getProjects";
import { formatDate } from "@/utils/formatDate";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(config.site.uiLang);

const posts = await getPublishedPosts();
const notes = await getPublishedNotes();
const writing = await getPublishedWriting();
const projects = getFeaturedProjects();

const featuredPosts = posts.filter(({ data }) => data.featured);
const recentPosts = posts.filter(({ data }) => !data.featured);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout width="wide">
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- Hero -->
    <section id="hero" class="border-border border-b pt-10 pb-10">
      <div
        class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start"
      >
        <div class="max-w-2xl">
          {
            /*
            The identity line comes first and in a smaller, wider-tracked
            style: it frames the name that follows and gives the visitor an
            immediate sense of who the site belongs to.
          */
          }
          <p
            class="text-muted-foreground flex items-center gap-2 text-sm font-medium tracking-[0.18em] uppercase"
            data-i18n="home.identity"
          >
            <span
              class="bg-accent inline-block size-1.5 shrink-0 rounded-full"
              aria-hidden="true"></span>
            {t.home.identity}
          </p>

          <h1 class="mt-4 text-4xl font-bold sm:text-5xl">
            <span
              class="text-muted-foreground mr-2 text-2xl font-normal sm:text-3xl"
              data-i18n="home.greeting"
            >
              {t.home.greeting}
            </span>
            {config.site.title}
          </h1>

          <p class="mt-5 text-lg leading-relaxed" data-i18n="home.intro">
            {t.home.intro}
          </p>

          <p
            class="text-muted-foreground mt-3 leading-relaxed"
            data-i18n="home.about"
          >
            {t.home.about}
          </p>

          <p
            class="text-accent mt-5 text-sm font-medium tracking-wide"
            data-i18n="home.keywords"
          >
            {t.home.keywords}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3">
            {
              socials.length > 0 && (
                <div class="flex max-w-full min-w-0 items-center">
                  <Socials />
                </div>
              )
            }
            <a
              target="_blank"
              href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
              class="focus-outline hover:text-accent text-muted-foreground inline-flex items-center gap-1.5 text-sm"
              aria-label={t.a11y.rssFeed}
              title={t.a11y.rssFeed}
              data-i18n="a11y.rssFeed"
              data-i18n-attr="aria-label"
            >
              <IconRss
                width={18}
                height={18}
                class="scale-110 stroke-current stroke-[2.5] rtl:-rotate-90"
              />
              <span data-i18n="home.rss">RSS</span>
            </a>
          </div>
        </div>

        {
          /*
          The logo doubles as the portrait of the site: a sloth hanging from
          a branch, unhurried — the nickname the author goes by.
        */
        }
        <SlothLogo
          class="stroke-accent hidden size-28 shrink-0 opacity-90 lg:block"
          aria-hidden="true"
        />
      </div>
    </section>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        {
          /*
          The notes come first: they are the most personal and the most
          frequently updated part of the site, so they should be visible
          without scrolling.
        */
        }
        {
          notes.length > 0 && (
            <section id="recent-notes" class="pt-12 pb-6">
              <h2
                class="text-2xl font-semibold tracking-wide"
                data-i18n="home.recentNotes"
              >
                {t.home.recentNotes}
              </h2>
              <ul class="mt-4" data-list-layout="timeline">
                {notes.slice(0, postsConfig.perIndex).map(note => (
                  <NoteCard note={note} />
                ))}
              </ul>
            </section>
          )
        }

        <!-- Featured projects -->
        {
          projects.length > 0 && (
            <section id="featured-projects" class="pt-12 pb-6">
              <h2
                class="text-2xl font-semibold tracking-wide"
                data-i18n="home.featuredProjects"
              >
                {t.home.featuredProjects}
              </h2>
              <ul class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2">
                {projects.map(project => (
                  <ProjectCard project={project} />
                ))}
              </ul>
            </section>
          )
        }

        <!-- Recent posts -->
        {
          recentPosts.length > 0 && (
            <section id="recent-posts" class="pt-12 pb-6">
              <h2
                class="text-2xl font-semibold tracking-wide"
                data-i18n="home.recentPosts"
              >
                {t.home.recentPosts}
              </h2>
              <ul data-list-layout="timeline">
                {recentPosts.slice(0, postsConfig.perIndex).map(post => (
                  <PostCard post={post} />
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="lg:col-span-1">
        <!-- Featured posts -->
        {
          featuredPosts.length > 0 && (
            <section id="featured" class="pt-12 pb-6">
              <h2
                class="text-2xl font-semibold tracking-wide"
                data-i18n="home.featured"
              >
                {t.home.featured}
              </h2>
              <ul>
                {featuredPosts.map(data => (
                  <li class="border-border border-b py-4 last:border-b-0">
                    <a
                      href={getPostUrl(data.id, data.filePath, locale)}
                      class="text-accent font-medium decoration-dashed underline-offset-4 hover:underline"
                    >
                      {data.data.title}
                    </a>
                    <p class="text-muted-foreground text-sm">
                      <time
                        datetime={new Date(
                          data.data.modDatetime ?? data.data.pubDatetime
                        ).toISOString()}
                        data-date={new Date(
                          data.data.modDatetime ?? data.data.pubDatetime
                        ).toISOString()}
                      >
                        {formatDate(
                          data.data.modDatetime ?? data.data.pubDatetime,
                          config.site.uiLang,
                          config.site.timezone
                        )}
                      </time>
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Recent writing -->
        {
          writing.length > 0 && (
            <section id="recent-writing" class="pt-12 pb-6">
              <h2
                class="text-2xl font-semibold tracking-wide"
                data-i18n="home.recentWriting"
              >
                {t.home.recentWriting}
              </h2>
              <ul class="border-border border-t">
                {writing.slice(0, postsConfig.perIndex).map(work => (
                  <WritingCard work={work} />
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>

    <div class="my-8 flex flex-wrap justify-center gap-4 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "notes")}>
        <span data-i18n="home.allNotes">{t.home.allNotes}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        <span data-i18n="home.allPosts">{t.home.allPosts}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={getRelativeLocaleUrl(locale, "writing")}>
        <span data-i18n="home.allWriting">{t.home.allWriting}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={getRelativeLocaleUrl(locale, "projects")}>
        <span data-i18n="home.allProjects">{t.home.allProjects}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
