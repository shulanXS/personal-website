---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TagBar from "@/components/TagBar.astro";
import TagEmpty from "@/components/TagEmpty.astro";
import { getProjects } from "@/utils/getProjects";
import { getTagIndex } from "@/utils/tagIndex";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(config.site.uiLang);

const projects = getProjects();

const { tags } = await getTagIndex(Astro.currentLocale ?? config.site.lang);
const projectTags = tags.filter(tag => tag.counts.projects > 0);
---

<Layout
  title={`${t.pages.projectsTitle} | ${t.site.title}`}
  titleKey="pages.projectsTitle"
  width="wide"
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.pages.projectsTitle}
    pageDesc={t.pages.projectsDesc}
    titleKey="pages.projectsTitle"
    descKey="pages.projectsDesc"
  >
    <div data-tag-scope="collection">
      <TagBar tags={projectTags} source="projects" />

      {
        projects.length === 0 ? (
          <p class="text-muted-foreground" data-i18n="pages.projectsEmpty">
            {t.pages.projectsEmpty}
          </p>
        ) : (
          <ul class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {projects.map(project => (
              <ProjectCard project={project} headingLevel="h2" />
            ))}
          </ul>
        )
      }

      <TagEmpty />
    </div>
  </Main>

  <Footer />
</Layout>
