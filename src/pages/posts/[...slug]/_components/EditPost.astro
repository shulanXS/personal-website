---
import type { CollectionEntry } from "astro:content";
import IconEdit from "@/assets/icons/IconEdit.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  hideEditPost?: CollectionEntry<"posts">["data"]["hideEditPost"];
  class?: string;
  post: CollectionEntry<"posts">;
};

const { hideEditPost, class: className = "" } = Astro.props;

/*
 * The link opens the content management backend, where the visitor picks
 * the collection to edit. It does not point at a single file, so the post
 * itself is not needed here.
 */
const editPost = config.features.editPost;
const href = editPost.enabled ? editPost.url : "";
const showEditPost = editPost.enabled && !hideEditPost && href.trim() !== "";

const t = useTranslations(config.site.uiLang);
---

{
  showEditPost && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        "hover:text-accent text-muted-foreground flex justify-baseline gap-1.5",
        className,
      ]}
    >
      <IconEdit class="inline-block" />
      <span data-i18n="post.editPage">{t.post.editPage}</span>
    </a>
  )
}
