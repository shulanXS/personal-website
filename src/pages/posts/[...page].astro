---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import PostCard from "@/components/PostCard.astro";
import TagBar from "@/components/TagBar.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getPublishedPosts } from "@/utils/content";
import { getTagIndex } from "@/utils/tagIndex";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const t = useTranslations(config.site.uiLang);

// Only the tags that actually occur in the blog posts are offered here —
// a tag that leads to an empty listing is noise.
const { tags } = await getTagIndex(Astro.currentLocale ?? config.site.lang);
const postTags = tags.filter(tag => tag.counts.posts > 0);

/*
 * The URLs of the other pages of this listing.
 *
 * A tag filter that only ever sees the current page would show an empty
 * result for a tag whose entries all live further down the pagination. The
 * script fetches these pages in the background when a filter is applied, so
 * that a tag always lists every entry of the collection carrying it.
 *
 * The paths are derived from the current URL so that they respect the
 * configured base path and the locale prefix.
 */
const listingRoot = Astro.url.pathname.replace(/\/\d+\/$/, "/");
const siblingPageUrls = Array.from(
  { length: page.lastPage },
  (_, index) => index + 1
)
  .filter(pageNumber => pageNumber !== page.currentPage)
  .map(
    pageNumber => `${listingRoot}${pageNumber === 1 ? "" : `${pageNumber}/`}`
  );
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`} width="list">
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.pages.postsTitle}
    pageDesc={t.pages.postsDesc}
    titleKey="pages.postsTitle"
    descKey="pages.postsDesc"
  >
    <div
      data-tag-scope="collection"
      data-list-pages={siblingPageUrls.join(",")}
    >
      <TagBar tags={postTags} source="posts" />

      <ul class="mt-6" data-list-layout="vertical">
        {page.data.map(post => <PostCard post={post} />)}
      </ul>

      <p
        class="text-muted-foreground mt-8 hidden"
        data-tag-empty
        data-i18n="tags.empty"
      >
        {t.tags.empty}
      </p>
    </div>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
