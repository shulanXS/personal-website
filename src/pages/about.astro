---
import MonogramLogo from "@/assets/monogram-logo.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { routeUrl } from "@/utils/routes";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(config.site.uiLang);

/**
 * The readable contact details.
 *
 * They are derived from the same config the social buttons use, so the
 * address shown here and the one behind the mail icon can never drift
 * apart. A detail that is not a URL — the WeChat ID — is offered as a
 * copy button instead of a link.
 */
const contactDetails = config.socials.map(({ name, url, copy }) => {
  const isMail = name === "mail";

  // The mail entry carries a `mailto:` URL; the address itself is what a
  // visitor reads, and the link still opens the mail client.
  const value = isMail ? (url?.replace("mailto:", "") ?? "") : (url ?? copy ?? "");

  return {
    key: isMail ? "email" : name,
    label:
      isMail
        ? t.about.contactLabels.email
        : (t.about.contactLabels[name as "github" | "wechat"] ?? name),
    value,
    // A detail with an address is a link; a detail that is only a string —
    // the WeChat ID — is copied instead.
    href: url,
    copy: url ? undefined : copy,
  };
});

const copyHint = t.about.contactCopyHint;
---

<Layout
    title={`${t.about.title} | ${t.site.title}`}
    titleKey="about.title"
    width="flow"
  >
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.about.title}
    pageDesc={t.about.desc}
    titleKey="about.title"
    descKey="about.desc"
  >
    {
      /*
      The card that holds the identity: the monogram, the name, the
      identity line and the circular social buttons.

      The mark is the same geometric monogram that appears in the header,
      so the page and the frame belong to one another.
      */
    }
    <section
      class="border-border bg-surface rounded-[var(--app-radius-lg)] border p-6 shadow-xs sm:p-8"
    >
      <div
        class="flex flex-col items-center gap-5 text-center sm:flex-row sm:items-center sm:gap-6 sm:text-left"
      >
        <MonogramLogo
          class="text-foreground size-16 shrink-0 sm:size-20"
          aria-hidden="true"
        />

        <div class="min-w-0">
          <h2 class="text-xl font-semibold sm:text-2xl" data-i18n="site.name">
            {t.site.name}
          </h2>
          <p
            class="text-muted-foreground mt-1 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm font-medium tracking-[0.18em] uppercase sm:justify-start"
            data-i18n="about.identity"
          >
            <span
              class="bg-accent inline-block size-1.5 shrink-0 rounded-full"
              aria-hidden="true"></span>
            {t.about.identity}
          </p>
        </div>

        <div
          class="flex shrink-0 items-center justify-center sm:ms-auto sm:justify-end"
        >
          <Socials align="center" size="sm" />
        </div>
      </div>
    </section>

    {
      /*
      The lead paragraph.

      It is set larger than the rest of the text, because it is the one
      sentence that has to be read even if nothing else is.
      */
    }
    <p class="mt-8 text-lg leading-relaxed" data-i18n="about.lead">
      {t.about.lead}
    </p>

    {
      /*
      The biography.

      Each section is a titled block. The sections are separated by a
      hairline rather than by a gap alone, so that the page keeps a clear
      rhythm when it is read on a phone.
      */
    }
    <div class="mt-10">
      {
        /*
        The sections are indexed rather than keyed by name, so the key of
        each one is its position: `about.sections.0.title`. The index is
        part of the key, which means the runtime switcher can rebuild
        every heading and paragraph of the biography in the other language.
        */
        t.about.sections.map((section, sectionIndex) => (
          <section class="border-border border-t pt-6 pb-2 first:border-t-0 first:pt-0">
            <h2
              class="text-lg font-semibold tracking-wide"
              data-i18n={`about.sections.${sectionIndex}.title`}
            >
              {section.title}
            </h2>
            {section.body.map((paragraph, paragraphIndex) => (
              <p
                class="text-foreground mt-3 leading-relaxed"
                data-i18n={`about.sections.${sectionIndex}.body.${paragraphIndex}`}
              >
                {paragraph}
              </p>
            ))}
          </section>
        ))
      }
    </div>

    {
      /*
      What the site holds.

      A short list of the four collections, each linking to its own
      listing page — the about page is the place where the reader finds
      out what the site is *for*.
      */
    }
    <section class="border-border mt-10 border-t pt-8">
      <h2
        class="text-lg font-semibold tracking-wide"
        data-i18n="about.hereTitle"
      >
        {t.about.hereTitle}
      </h2>

      <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          t.about.hereItems.map((item, itemIndex) => (
            <li class="border-border bg-surface rounded-[var(--app-radius)] border p-4">
              <a
                href={routeUrl(locale, item.route)}
                class="hover:text-accent block transition-colors"
              >
                <h3
                  class="text-accent font-medium"
                  data-i18n={`about.hereItems.${itemIndex}.label`}
                >
                  {item.label}
                </h3>
                <p
                  class="text-muted-foreground mt-1 text-sm leading-relaxed"
                  data-i18n={`about.hereItems.${itemIndex}.desc`}
                >
                  {item.desc}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      /*
      The contact block.

      The social buttons are the same circular ones that appear in the
      header area and in the footer, so the way to reach the author looks
      the same everywhere on the site.
      */
    }
    <section class="border-border mt-10 border-t pt-8">
      <h2
        class="text-lg font-semibold tracking-wide"
        data-i18n="about.contactTitle"
      >
        {t.about.contactTitle}
      </h2>
      <p
        class="text-muted-foreground mt-3 leading-relaxed"
        data-i18n="about.contactDesc"
      >
        {t.about.contactDesc}
      </p>

      <div class="mt-5">
        <Socials align="start" size="md" />
      </div>

      {
        /*
        The readable contact list.

        The buttons above are icons: they say *where* to write, but not
        *what* to write. A visitor looking for the address has to be able
        to read it, and a visitor looking for the WeChat ID has to be able
        to copy it — a string like "shulan203" is not a link.
        */
      }
      <dl class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {contactDetails.map(({ key, label, value, href, copy }) => (
          <div class="border-border bg-surface rounded-[var(--app-radius)] border px-4 py-3">
            <dt
              class="text-muted-foreground text-xs font-medium tracking-[0.14em] uppercase"
              data-i18n={`about.contactLabels.${key}`}
            >
              {label}
            </dt>
            <dd class="mt-1 text-sm">
              {href ? (
                <a
                  href={href}
                  class="text-accent hover:underline"
                  target={href.startsWith("http") ? "_blank" : undefined}
                  rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
                >
                  {value}
                </a>
              ) : (
                <button
                  type="button"
                  class="text-accent hover:underline"
                  data-copy-value={copy}
                  aria-label={`${value} — ${copyHint}`}
                >
                  {value}
                </button>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  </Main>

  <Footer />
</Layout>
