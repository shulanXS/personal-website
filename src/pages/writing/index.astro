---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import WritingFilter from "@/components/WritingFilter.astro";
import WritingContents from "@/components/WritingContents.astro";
import TagEmpty from "@/components/TagEmpty.astro";
import { getPublishedWriting } from "@/utils/content";
import { buildWritingFacets, groupWriting } from "@/utils/writingMeta";
import { getTagIndex } from "@/utils/tagIndex";
import { tagDisplayName } from "@/utils/tagIndex";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(config.site.uiLang);

const works = await getPublishedWriting();

/*
 * The works are grouped into series first and standalone works second, so
 * that a novel is read as one thing with chapters rather than as a list of
 * chapters that happen to share a tag.
 */
const { series, standalone } = groupWriting(works);

/*
 * The filter of the page.
 *
 * The kinds and the works come from the shape of the collection itself;
 * the tags that cut across kinds come from the tag index. A tag that
 * repeats the name of a series is left out — the second level of the
 * filter already offers it.
 */
const facets = buildWritingFacets(
  { series, standalone },
  {
    novel: t.writing.novel,
    essay: t.writing.essay,
    short: t.writing.short,
  }
);

const workNames = new Set(facets.works.map(work => work.value));

/*
 * The names of the kinds of work, in the interface language.
 *
 * A tag that repeats a kind ("小说") is left out of the tag level: the
 * first level of the filter already says it, and offering it twice would
 * say the same thing in two places.
 */
const typeNames = new Set(facets.types.map(type => type.label));

const { tags } = await getTagIndex(Astro.currentLocale ?? config.site.lang);

const freeTags = tags
  .filter(tag => tag.counts.writing > 0)
  .filter(tag => !workNames.has(tag.name))
  .filter(tag => !typeNames.has(tag.name))
  .map(tag => ({
    slug: tag.slug,
    name: tagDisplayName(tag.name),
    count: tag.counts.writing,
  }));
---

<Layout
  title={`${t.pages.writingTitle} | ${t.site.title}`}
  titleKey="pages.writingTitle"
  width="wide"
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.pages.writingTitle}
    pageDesc={t.pages.writingDesc}
    titleKey="pages.writingTitle"
    descKey="pages.writingDesc"
  >
    <div data-tag-scope="collection" data-pagefind-ignore>
      {
        works.length === 0 ? (
          <p class="text-muted-foreground" data-i18n="pages.writingEmpty">
            {t.pages.writingEmpty}
          </p>
        ) : (
          <>
            <WritingFilter
              types={facets.types}
              works={facets.works}
              tags={freeTags}
            />
            <WritingContents series={series} standalone={standalone} />
          </>
        )
      }

      <TagEmpty />
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  import "@/scripts/writingFilter";
</script>
