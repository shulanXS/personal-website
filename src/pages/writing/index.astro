---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import WritingFilter from "@/components/WritingFilter.astro";
import WritingContents from "@/components/WritingContents.astro";
import TagEmpty from "@/components/TagEmpty.astro";
import { getPublishedWriting } from "@/utils/content";
import {
  buildWritingFacets,
  groupWriting,
  WRITING_TYPE_TAGS,
} from "@/utils/writingMeta";
import { getTagIndex } from "@/utils/tagIndex";
import { tagDisplayName } from "@/utils/tagIndex";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(config.site.uiLang);

const works = await getPublishedWriting();

/*
 * The works are grouped into series first and standalone works second, so
 * that a novel is read as one thing with chapters rather than as a list of
 * chapters that happen to share a tag.
 *
 * Standalone articles appear newest first, followed by the novels.
 */
const { series, standalone, blocks } = groupWriting(works);

/*
 * The filter of the page.
 *
 * The kinds and the works come from the shape of the collection itself;
 * the tags that cut across kinds come from the tag index. A tag that
 * repeats the name of a series is left out — the second level of the
 * filter already offers it.
 */
const facets = buildWritingFacets(
  { series, standalone },
  {
    novel: t.writing.novel,
    essay: t.writing.essay,
    review: t.writing.review,
    game: t.writing.game,
    character: t.writing.character,
    short: t.writing.short,
  }
);

const workNames = new Set(
  [...facets.series, ...facets.standalone].map(work => work.value)
);

/*
 * The tags that name a kind of work.
 *
 * A work carries its kind twice: in the `type` field, and often in a tag
 * as well ("小说" on every chapter of a novel). The tag level of the
 * filter leaves these out — the first level already says which kind a
 * work is, and offering it twice would say the same thing in two places.
 *
 * The list is the tags the author writes, not the labels of the
 * interface: the dictionary says "原创小说", the content says "小说",
 * and only the second one is a tag.
 */
const typeTags = new Set<string>(WRITING_TYPE_TAGS);

const { tags } = await getTagIndex(Astro.currentLocale ?? config.site.lang);

const freeTags = tags
  .filter(tag => tag.counts.writing > 0)
  .filter(tag => !workNames.has(tag.name))
  .filter(tag => !typeTags.has(tag.name))
  .map(tag => ({
    slug: tag.slug,
    name: tagDisplayName(tag.name),
    count: tag.counts.writing,
  }));
---

<Layout
  title={`${t.pages.writingTitle} | ${t.site.title}`}
  titleKey="pages.writingTitle"
  width="wide"
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.pages.writingTitle}
    pageDesc={t.pages.writingDesc}
    titleKey="pages.writingTitle"
    descKey="pages.writingDesc"
  >
    <div data-tag-scope="collection" data-pagefind-ignore>
      {
        works.length === 0 ? (
          <p class="text-muted-foreground" data-i18n="pages.writingEmpty">
            {t.pages.writingEmpty}
          </p>
        ) : (
          <>
            <WritingFilter
              types={facets.types}
              series={facets.series}
              standalone={facets.standalone}
              tags={freeTags}
            />
            <WritingContents blocks={blocks} />
          </>
        )
      }

      <TagEmpty />
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  import "@/scripts/writingFilter";
</script>
