---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import TagChip from "@/components/TagChip.astro";
import WritingBackButton from "@/components/WritingBackButton.astro";
import { getPublishedWriting } from "@/utils/content";
import { getWritingUrl } from "@/utils/getPostPaths";
import { tagSlug, tagDisplayName } from "@/utils/tagIndex";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async () => {
  const works = await getPublishedWriting();

  // Chapter navigation is derived from the sibling chapters of the same
  // series, ordered by `chapterNumber`.
  const bySeries = new Map<string, typeof works>();
  for (const work of works) {
    const series = work.data.series;
    if (!series) continue;
    const list = bySeries.get(series) ?? [];
    list.push(work);
    bySeries.set(series, list);
  }

  return works.map(work => {
    const siblings = work.data.series
      ? (bySeries.get(work.data.series) ?? [])
          .slice()
          .sort(
            (a, b) => (a.data.chapterNumber ?? 0) - (b.data.chapterNumber ?? 0)
          )
      : [];
    const index = siblings.findIndex(sibling => sibling.id === work.id);

    return {
      params: { slug: work.data.slug },
      props: {
        work,
        prevWork: index > 0 ? siblings[index - 1] : null,
        nextWork:
          index >= 0 && index < siblings.length - 1
            ? siblings[index + 1]
            : null,
        seriesSiblings: siblings,
      },
    };
  });
}) satisfies GetStaticPaths;

const { work, prevWork, nextWork, seriesSiblings } = Astro.props;
const { data } = work;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(config.site.uiLang);

const { Content } = await render(work);

const tags = data.tags ?? [];
---

<Layout title={`${data.title} | ${t.site.title}`} width="reading">
  <Header />

  <Breadcrumb />

  <main
    id="main-content"
    class="app-layout pb-4"
    data-pagefind-body
    data-pagefind-meta="type:writing"
  >
    {/*
      The header of a chapter.

      The series name sits *above* the title rather than inside it: the
      title of a chapter is only meaningful inside its series, so the
      two are two lines of one header, not one line of text. Reading
      "雪落江川 · 第二天：微小的步伐" as a single string makes the eye
      hunt for where the work ends and the chapter begins.

      The chapter number is deliberately absent. The title already says
      "第二天", and a "第 2" underneath it says the same fact a second
      time, in a form that is also wrong the moment a chapter is
      re-numbered. The status badge was dropped for the same reason:
      it is a fact about the whole series, and it is already stated once
      in the series heading on the list page.
    */}
    {
      data.series && (
        <p class="app-writing-series mb-1 text-sm">{data.series}</p>
      )
    }
    <h1 class="app-writing-title text-2xl font-semibold sm:text-3xl">
      {data.title}
    </h1>
    <div class="mt-2 mb-6">
      <Datetime pubDatetime={data.pubDatetime} modDatetime={data.modDatetime} />
    </div>

    {/*
      The one-line summary of the chapter.

      It is set in the serif face, like the chapter itself, and it is not
      italic: the text is Chinese, and a slanted CJK face is a faked
      oblique that looks like a mistake rather than like emphasis. It is
      separated from the body by a rule instead, so that it reads as a
      standfirst rather than as a paragraph of the story.
    */}
    {data.description && (
      <p class="app-writing-standfirst">{data.description}</p>
    )}

    <article id="article" class="app-prose app-prose-serif max-w-app-reading">
      <Content />
    </article>

    {
      tags.length > 0 && (
        <ul class="mt-6 mb-6 flex flex-wrap gap-2">
          {tags.map(tag => (
            <li>
              <TagChip
                slug={tagSlug(tag)}
                name={tagDisplayName(tag)}
                mode="static"
                size="sm"
              />
            </li>
          ))}
        </ul>
      )
    }

    {
      seriesSiblings.length > 1 && (
        <nav
          class="border-border mt-12 border-t pt-6"
          aria-label={t.writing.tableOfContents}
          data-i18n="writing.tableOfContents"
          data-i18n-attr="aria-label"
        >
          <h2
            class="text-lg font-semibold"
            data-i18n="writing.tableOfContents"
          >
            {t.writing.tableOfContents}
          </h2>
          {/*
            The table of contents lists the chapters by their own titles.

            The chapter number was removed here too: the titles of this
            series already begin with "第一天", "第二天" and so on, so a
            leading "2." only repeated what the title says, in a
            different notation.
          */}
          <ol class="mt-3 flex flex-col gap-2">
            {seriesSiblings.map(sibling => (
              <li>
                <a
                  href={getWritingUrl(sibling.data.slug, locale)}
                  class:list={[
                    "hover:text-accent decoration-dashed underline-offset-4",
                    { "text-accent font-medium": sibling.id === work.id },
                  ]}
                >
                  {sibling.data.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      (prevWork || nextWork) && (
        <nav
          class="mt-8 flex flex-wrap justify-between gap-4"
          aria-label={t.writing.chapterNavigation}
          data-i18n="writing.chapterNavigation"
          data-i18n-attr="aria-label"
        >
          {prevWork ? (
            <a
              href={getWritingUrl(prevWork.data.slug, locale)}
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              ← {prevWork.data.title}
            </a>
          ) : (
            <span />
          )}
          {nextWork && (
            <a
              href={getWritingUrl(nextWork.data.slug, locale)}
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              {nextWork.data.title} →
            </a>
          )}
        </nav>
      )
    }
  </main>

  {/*
    The floating button that returns to the list of works.

    It lives outside the main column, because it is anchored to the
    viewport rather than to the text: it stays in the same corner of the
    screen while the chapter scrolls underneath it.
  */}
  <WritingBackButton />

  <Footer />
</Layout>

<script>
  import { initLightbox } from "@/scripts/lightbox";

  document.addEventListener("astro:page-load", () => initLightbox());
</script>
