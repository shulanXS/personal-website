---
import { flatRuntimeTranslations, useTranslations } from "@/i18n";
import { formatTemplate } from "@/i18n/format";
import config from "@/config";

type Props = {
  value: number;
  tone?: "default" | "character" | "game";
};

const { value, tone = "default" } = Astro.props;
const t = useTranslations(config.site.uiLang);
const score = Math.min(5, Math.max(0, value));
const opacity = (30 + 10 * score) / 100;
const written = score.toFixed(1);
const dict = flatRuntimeTranslations[config.site.uiLang] ?? {};
const symbols = {
  default: [
    "star",
    "ratingAccessible",
    "M20 1 26 10 38 12 31 21 32 34 20 29 8 34 9 21 2 12 14 10Z",
  ],
  character: [
    "heart",
    "characterAffinityAccessible",
    "M20 34C16 31 2 23 2 13 2 2 14 0 20 8 26 0 38 2 38 13 38 23 24 31 20 34Z",
  ],
  game: [
    "gamepad",
    "gameRatingAccessible",
    "M12 6c-4 0-6 3-7 7L1 27c-1 5 3 7 6 4l6-7h14l6 7c3 3 7 1 6-4l-4-14c-1-4-3-7-7-7l-5 2h-6z M9 11h3v3h3v3h-3v3H9v-3H6v-3h3z M28 12a2 2 0 1 0 4 0 2 2 0 1 0-4 0z M24 17a2 2 0 1 0 4 0 2 2 0 1 0-4 0z",
  ],
} as const;
const [symbol, label, path] = symbols[tone];
const glyphs = [
  "M5 1C2.4 1 1 3.3 1 7s1.4 6 4 6 4-2.3 4-6S7.6 1 5 1Z",
  "M2.2 3.8 5.4 1v12M2 13h6",
  "M1.2 4C1.2.3 8.7-.2 8.7 4c0 2.1-1.9 3.6-4.1 5.2L1.2 13h7.6",
  "M1.4 2.7C3.5.1 8.5.5 8.5 4c0 1.7-1.5 2.8-4 3 2.5 0 4.3 1.1 4.3 3.2 0 3.5-5.7 4.1-7.6 1.1",
  "M7.3 13V1L.9 9.1h8.3",
  "M8.5 1.3H2l-.5 5.4c3.2-2.1 7.2-1.1 7.2 2.6 0 4.1-5.4 5.1-7.6 2.3",
  "M8 1.2C3.4 1.7 1 5.3 1 9.1c0 2.5 1.6 4 4 4s4-1.5 4-3.8S7.4 5.8 5.2 5.8c-2 0-3.5 1-4.1 2.6",
  "M1 3.4V1.3h8L3.3 13",
  "M5 1c-4.6 0-4.8 4.6 0 6 5.3 1.6 5 6 0 6s-5.3-4.4 0-6C9.8 5.6 9.6 1 5 1Z",
  "M2 13c4.6-.6 7-4.3 7-8.1C9 2.5 7.4 1 5 1S1 2.5 1 4.8s1.6 3.5 3.8 3.5c2 0 3.5-1 4.1-2.6",
];
---

<svg
  viewBox="5.62 3.75 58.76 40.25"
  class:list={["app-rating", `app-rating-${tone}`]}
  style={`--rating-strength: 100%; opacity: ${opacity}`}
  data-rating-symbol={symbol}
  role="img"
  aria-label={formatTemplate(t.writing[label], dict, [written])}
  data-i18n={`writing.${label}`}
  data-i18n-attr="aria-label"
  data-i18n-args={written}
>
  <rect
    x="6.12"
    y="8"
    width="57.76"
    height="27"
    rx="8"
    fill="currentColor"
    fill-opacity=".065"></rect>
  <path d="M28.204706 15v13" stroke="currentColor" stroke-width=".8" opacity=".3"></path>
  <svg
    x="9.712753"
    y="14.0504"
    width="14.8992"
    height="14.8992"
    viewBox="0 0 40 36"
  >
    <path d={path} fill="currentColor" fill-rule="evenodd"></path>
  </svg>
  <g transform={`translate(46.042353 21.5) scale(${score === 5 ? 1.02 : 0.865628}) translate(-28 -21)`}>
    {
      [0, 2].map(index => (
        <path
          data-digit={written[index]}
          transform={`translate(${index === 0 ? 15 : 31} 14)`}
          d={glyphs[Number(written[index])]}
          fill="none"
          stroke="currentColor"
          stroke-width="2.35"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      ))
    }
    <path fill="currentColor" d="m28 24.1 1.35 1.35L28 26.8l-1.35-1.35Z"></path>
  </g>
</svg>

<style>
  svg.app-rating {
    display: inline-block;
    width: 52.884px;
    max-width: 100%;
    color: var(--rating);
    height: auto;
    flex: none;
    overflow: visible;
  }
</style>
