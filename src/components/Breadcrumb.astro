---
import { stripBase, stripLocale } from "@/utils/withBase";
import { pathUrl, routeUrl } from "@/utils/routes";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(config.site.uiLang);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  notes: t.nav.notes,
  writing: t.nav.writing,
  projects: t.nav.projects,
  about: t.nav.about,
  search: t.nav.search,
};

/** Translation keys for the breadcrumb segments, so they can be swapped live. */
const navLabelKeys: Record<string, string> = {
  posts: "nav.posts",
  notes: "nav.notes",
  writing: "nav.writing",
  projects: "nav.projects",
  about: "nav.about",
  search: "nav.search",
};

/*
 * The posts listing is not paginated any more — every article is on the
 * one page — so its crumb carries no page number.
 *
 * The article pages sit *under* the listing, and their crumb stops at the
 * listing as well: the slug of an article is not something a reader needs
 * to see in a trail of links.
 */
if (breadcrumbList[0] === "posts") {
  breadcrumbList.splice(1);
}

// The standalone tag pages are gone — the tags now live on the search
// page — so there is no tag-specific breadcrumb handling left.
---

<nav
  class="app-layout mt-8 mb-1"
  aria-label={t.a11y.breadcrumb}
  data-i18n="a11y.breadcrumb"
  data-i18n-attr="aria-label"
>
  <ul
    class="flex flex-wrap items-center gap-x-1 font-light [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li class="flex items-center gap-x-1">
      <a href={routeUrl(locale, "home")} class="opacity-80">
        <span data-i18n="nav.home">{t.nav.home}</span>
      </a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) => {
        const i18nKey = navLabelKeys[breadcrumb];
        const label = navLabels[breadcrumb] ?? decodeSegment(breadcrumb);

        return index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
              data-i18n={i18nKey}
            >
              {/* make the last part lowercase in Home > Tags > some-tag */}
              {label}
            </span>
          </li>
        ) : (
          <li class="flex items-center gap-x-1">
            <a
              href={pathUrl(locale, breadcrumb)}
              class="capitalize opacity-70"
              data-i18n={i18nKey}
            >
              {label}
            </a>
            <span aria-hidden="true" class="opacity-70">
              &raquo;
            </span>
          </li>
        );
      })
    }
  </ul>
</nav>
