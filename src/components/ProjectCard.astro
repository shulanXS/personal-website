---
import type { Project } from "@/utils/getProjects";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { tagSlug, tagDisplayName } from "@/utils/tagIndex";
import { useTranslations } from "@/i18n";
import config from "@/config";
import TagChip from "./TagChip.astro";

type Props = {
  project: Project;
  /**
   * The heading level of the project name.
   *
   * On the project listing the page title is the `h1`, so the cards use
   * `h2`. On the home page the cards sit under a section heading, so they
   * use `h3`.
   */
  headingLevel?: "h2" | "h3";
};

const { project, headingLevel: Heading = "h3" } = Astro.props;

const t = useTranslations(config.site.uiLang);

const tags = project.tags ?? [];
const tagSlugs = tags.map(tagSlug);
---

<li
  class="app-card flex h-full flex-col p-5"
  data-tagged-item
  data-tags={tagSlugs.join(",")}
>
  {
    project.screenshot && (
      <img
        src={project.screenshot}
        alt={`${project.name} screenshot`}
        loading="lazy"
        class="border-border mb-4 aspect-[16/9] w-full rounded border object-cover sm:aspect-[16/10]"
      />
    )
  }
  <Heading class="text-lg font-semibold">{project.name}</Heading>
  {
    project.description && (
      <p class="mt-2 grow text-sm">{project.description}</p>
    )
  }
  {
    project.techStack && project.techStack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.techStack.map(tech => (
          <li class="border-border text-muted-foreground rounded border px-2 py-0.5 text-xs">
            {tech}
          </li>
        ))}
      </ul>
    )
  }
  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.map(tag => (
          <li>
            <TagChip
              slug={tagSlug(tag)}
              name={tagDisplayName(tag)}
              mode="static"
              size="sm"
            />
          </li>
        ))}
      </ul>
    )
  }
  <div class="mt-4 flex flex-wrap gap-4 text-sm">
    {
      project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          <span data-i18n="projects.github">{t.projects.github}</span>
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </a>
      )
    }
    {
      project.demo && (
        <a
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          <span data-i18n="projects.demo">{t.projects.demo}</span>
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </a>
      )
    }
  </div>
</li>
