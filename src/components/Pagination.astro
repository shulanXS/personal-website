---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { canonicalizeUrl } from "@/utils/routes";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(config.site.uiLang);

// The pagination URLs come from Astro, which decides on the trailing slash
// by itself. They are normalised here so that a page link is always the
// canonical URL of that page.
const prevUrl = canonicalizeUrl(page.url.prev);
const nextUrl = canonicalizeUrl(page.url.next);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center gap-4"
      role="navigation"
      aria-label={t.a11y.paginationNavigation}
      data-i18n="a11y.paginationNavigation"
      data-i18n-attr="aria-label"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={prevUrl}
        class:list={["select-none", { "opacity-50": !page.url.prev }]}
        aria-label={t.a11y.goToPreviousPage}
        data-i18n="a11y.goToPreviousPage"
        data-i18n-attr="aria-label"
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        <span data-i18n="pagination.prev">{t.pagination.prev}</span>
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={nextUrl}
        class:list={["select-none", { "opacity-50": !page.url.next }]}
        aria-label={t.a11y.goToNextPage}
        data-i18n="a11y.goToNextPage"
        data-i18n-attr="aria-label"
      >
        <span data-i18n="pagination.next">{t.pagination.next}</span>
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
