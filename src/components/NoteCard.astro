---
import type { CollectionEntry } from "astro:content";
import { tagSlug, tagDisplayName } from "@/utils/tagIndex";
import { useTranslations } from "@/i18n";
import config from "@/config";
import Datetime from "./Datetime.astro";
import TagChip from "./TagChip.astro";

type Props = {
  note: CollectionEntry<"notes">;
  /** Long notes are clamped; `expanded` shows them in full right away. */
  expanded?: boolean;
};

const { note, expanded = false } = Astro.props;
const { data, id } = note;

const t = useTranslations(config.site.uiLang);

const isLong = data.content.length > 280;

const tags = data.tags ?? [];
const tagSlugs = tags.map(tagSlug);

/*
 * A note without a title still needs a heading, because Pagefind turns every
 * heading into its own search result ("sub result"). The first words of the
 * note serve as that heading — visually hidden, so the list still reads as
 * a clean timeline.
 *
 * The text is sanitized because Pagefind parses `key:value` pairs — a colon
 * inside the value would be read as the start of the next pair.
 */
const indexTitle = (
  data.title ??
  (data.content.slice(0, 40).trim() || "note")
).replace(/[\r\n:;]+/g, " ");
---

<li data-tagged-item data-tags={tagSlugs.join(",")}>
  {
    /*
    The date lives in a narrow column on the left of the vertical rule, so
    the moment a note was written is readable at a glance. The day and the
    time are stacked on top of each other, because the column is narrower
    than a full timestamp.

    That column only exists from `sm` upwards. Below it the date is
    rendered *inside* the entry instead — see the second `Datetime` below.
    Putting it inside the panel rather than above it means that a note and
    its date are one object: on a phone the date used to sit between two
    panels, and it was not clear which panel it belonged to.
  */
  }
  <div class="app-timeline-date hidden sm:block" data-pagefind-ignore>
    <Datetime pubDatetime={data.pubDatetime} bare stacked />
  </div>

  {
    /*
    The entry itself is a bubble.

    There is no avatar: the shape of the bubble alone is what makes the
    note read as a message. The tail on the left points into the empty
    space where the speaker would be.
  */
  }
  <article class="app-note min-w-0">
    <div class="app-note-column min-w-0">
      {
        /*
        The date, for the narrow screens where there is no column for it.
        It sits above the bubble, so that the bubble keeps its own clean
        shape.
      */
      }
      <div class="app-timeline-date mb-1.5 sm:hidden" data-pagefind-ignore>
        <Datetime pubDatetime={data.pubDatetime} bare stacked />
      </div>

      <div class="app-note-bubble">
        {
          /*
            The heading gives every note its own search result. For a note
            that has a title it is the visible title; for an untitled note
            it is a hidden fallback so that the entry is still findable and
            still shows up as a sub result under the listing.

            The `id` matters: Pagefind turns a heading with an id into a
            sub result that links straight to this note.
          */
        }
        {
          data.title ? (
            <h2 id={`note-${id}`} class="text-lg font-semibold">
              {data.title}
            </h2>
          ) : (
            <h2 id={`note-${id}`} class="sr-only">
              {indexTitle}
            </h2>
          )
        }
        {
          data.content && (
            <p
              class:list={[
                "text-foreground break-words whitespace-pre-wrap",
                { "line-clamp-6": !expanded && isLong },
              ]}
              data-note-body
            >
              {data.content}
            </p>
          )
        }
        {
          data.images && data.images.length > 0 && (
            <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              {data.images.map((src, index) => {
                const alt = data.imageAlts?.[index] ?? "";
                return (
                  <li>
                    <img
                      src={src}
                      alt={alt}
                      loading="lazy"
                      width={400}
                      height={300}
                      class="border-border h-full w-full rounded border object-cover"
                    />
                  </li>
                );
              })}
            </ul>
          )
        }
        {
          isLong && (
            <div
              class="text-muted-foreground mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
              data-pagefind-ignore
            >
              <button
                type="button"
                class="text-accent focus-outline decoration-dashed underline-offset-4 hover:underline"
                data-note-expand
                aria-expanded="false"
              >
                <span data-note-label-expand data-i18n="notes.expand">
                  {t.notes.expand}
                </span>
                <span
                  data-note-label-collapse
                  data-i18n="notes.collapse"
                  hidden
                >
                  {t.notes.collapse}
                </span>
              </button>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <ul class="mt-1 flex flex-wrap gap-2" data-pagefind-ignore>
              {tags.map(tag => (
                <li>
                  <TagChip
                    slug={tagSlug(tag)}
                    name={tagDisplayName(tag)}
                    mode="static"
                    size="sm"
                  />
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </article>
</li>

<script>
  import { initLightbox } from "@/scripts/lightbox";

  /*
   * Long notes are clamped to six lines on the listing pages. The button
   * below expands them in place — no navigation, no page reload — and
   * collapses them again on a second click.
   *
   * The listener is delegated from the document so it survives the
   * client-side navigations of the view transitions router.
   */
  function setupNoteExpand() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-note-expand]")
      .forEach(button => {
        if (button.dataset.noteExpandReady === "true") return;
        button.dataset.noteExpandReady = "true";

        const item = button.closest("[data-tagged-item]");
        const body = item?.querySelector<HTMLElement>("[data-note-body]");
        if (!body) return;

        const expandLabel = button.querySelector<HTMLElement>(
          "[data-note-label-expand]"
        );
        const collapseLabel = button.querySelector<HTMLElement>(
          "[data-note-label-collapse]"
        );

        button.addEventListener("click", () => {
          const isExpanded = body.classList.toggle("line-clamp-6") === false;
          button.setAttribute("aria-expanded", String(isExpanded));
          if (expandLabel) expandLabel.hidden = isExpanded;
          if (collapseLabel) collapseLabel.hidden = !isExpanded;
        });
      });
  }

  /*
   * The images of a note open in the shared lightbox, so that a picture
   * can be read at full size without leaving the timeline.
   *
   * The lightbox is bound to the list rather than to a single entry, so
   * that every picture of the page can be opened. The binding is marked on
   * the list itself, which keeps it from being attached twice.
   */
  function setupNoteLightbox() {
    initLightbox({ containerSelector: 'ul[data-list-layout="notes"]' });
  }

  document.addEventListener("astro:page-load", setupNoteExpand);
  document.addEventListener("astro:page-load", setupNoteLightbox);
</script>
