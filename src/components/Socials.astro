---
import config from "@/config";
import LinkButton from "./LinkButton.astro";

const { site, socials } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

/**
 * The icons are resolved from the file system at build time, so an entry
 * whose SVG is missing is skipped rather than breaking the build. Every
 * social in the config ships an explicit `linkTitle`, which is the only
 * source of truth for the accessible label — the fallback below is just a
 * safety net for hand-edited configs.
 */
const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (url.startsWith("mailto:") || name === "mail"
        ? `Send an email to ${site.title}`
        : `${site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`);
    return { url, title, Icon };
  })
);

const visible = items.filter(item => item.Icon);

/*
 * The icons wrap onto a second row when they do not fit. A scrolling row
 * would be hidden behind the edge of the screen, and the visitor would
 * never discover the platforms that are off-screen.
 */
const rowClasses =
  "flex w-full flex-wrap items-center gap-0.5 sm:w-auto sm:justify-end";
---

{
  visible.length > 0 && (
    <div class={rowClasses}>
      {visible.map(({ url, title, Icon }) => (
        <LinkButton
          href={url}
          class="hover:text-accent shrink-0 p-2 transition-colors duration-200 hover:rotate-6"
          title={title}
        >
          <Icon class="inline-block size-5 fill-transparent stroke-current stroke-[1.75] opacity-80" />
          <span class="sr-only">{title}</span>
        </LinkButton>
      ))}
    </div>
  )
}
