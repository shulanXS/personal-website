---
import config from "@/config";
import { useTranslations } from "@/i18n";

const { socials } = config;
const t = useTranslations(config.site.uiLang);

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

/**
 * The icons are resolved from the file system at build time, so an entry
 * whose SVG is missing is skipped rather than breaking the build.
 *
 * The accessible label comes from the interface dictionary: a Chinese
 * interface says "发送邮件" where the English one says "Send an email".
 * The `linkTitle` of the config is the fallback for a platform the
 * dictionary does not know about.
 */
const items = await Promise.all(
  socials.map(async ({ name, url, copy, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;

    /*
     * The label comes from the interface dictionary when the platform is
     * one the dictionary knows about, so that it can be swapped at
     * runtime. The key is carried along with the label, because the
     * runtime switcher works with keys rather than with strings.
     */
    const known = name as keyof typeof t.socials;
    const i18nKey = known in t.socials ? `socials.${name}` : undefined;

    const title = i18nKey
      ? t.socials[known]
      : (linkTitle ??
        (url?.startsWith("mailto:") || name === "mail"
          ? t.socials.mailTo
          : `${t.site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`));

    return { url, copy, title, Icon, i18nKey };
  })
);

const visible = items.filter(item => item.Icon);

type Props = {
  /**
   * How the row of buttons is aligned.
   *
   * The hero puts them under the intro text, the footer puts them in the
   * middle of the brand line. Both are centred or left-aligned depending
   * on the place, so the alignment is a prop rather than a fixed value.
   */
  align?: "start" | "center" | "end";
  /**
   * The size of the buttons.
   *
   * "sm" is used in the footer, where the buttons sit in a line with the
   * site name; "md" in the hero, where they carry more weight.
   */
  size?: "sm" | "md";
  class?: string;
};

const { align = "start", size = "md", class: className = "" } = Astro.props;

const alignClasses = {
  start: "justify-start",
  center: "justify-center",
  end: "justify-end",
};

const buttonSizeClasses = {
  sm: "size-8",
  md: "size-10",
};

const iconSizeClasses = {
  sm: "size-4",
  md: "size-5",
};
---

{
  visible.length > 0 && (
    <div
      class:list={[
        "flex w-full flex-wrap items-center gap-2",
        alignClasses[align],
        className,
      ]}
    >
      {visible.map(({ url, copy, title, Icon, i18nKey }) =>
        /*
        A platform that cannot be linked to — a WeChat ID, for instance —
        becomes a button that copies the value instead of a link. A link
        that goes nowhere is worse than no link at all.
        */
        copy ? (
          <button
            type="button"
            class:list={[
              "border-border text-muted-foreground hover:border-accent hover:text-accent focus-outline shrink-0 rounded-full border transition-all duration-200 hover:-translate-y-0.5",
              buttonSizeClasses[size],
            ]}
            title={title}
            aria-label={title}
            data-copy-value={copy}
            data-i18n-attr={i18nKey ? "title,aria-label" : undefined}
            data-i18n={i18nKey}
          >
            <span class="flex h-full w-full items-center justify-center">
              <Icon
                class:list={[
                  "inline-block fill-current stroke-none opacity-80",
                  iconSizeClasses[size],
                ]}
              />
            </span>
            <span class="sr-only" data-i18n={i18nKey}>
              {title}
            </span>
          </button>
        ) : (
          <a
            href={url}
            class:list={[
              "border-border text-muted-foreground hover:border-accent hover:text-accent focus-outline shrink-0 rounded-full border transition-all duration-200 hover:-translate-y-0.5",
              buttonSizeClasses[size],
            ]}
            title={title}
            aria-label={title}
            data-social={url?.startsWith("mailto:") ? "mail" : url}
            data-i18n-attr={i18nKey ? "title,aria-label" : undefined}
            data-i18n={i18nKey}
          >
            <span class="flex h-full w-full items-center justify-center">
              <Icon
                class:list={[
                  "inline-block fill-current stroke-none opacity-80",
                  iconSizeClasses[size],
                ]}
              />
            </span>
            <span class="sr-only" data-i18n={i18nKey}>
              {title}
            </span>
          </a>
        )
      )}
    </div>
  )
}
