---
import { useTranslations } from "@/i18n";
import config from "@/config";

/**
 * One option of the first level: a kind of work.
 */
type TypeOption = {
  /** The value of the `type` field of the works. */
  value: string;
  /** The label of the kind, in the interface language. */
  label: string;
  /** How many works carry it. */
  count: number;
};

/**
 * One option of the second level: a single work or a series.
 */
type WorkOption = {
  /** The name of the work, which is what the filter matches on. */
  value: string;
  /** The label of the work. */
  label: string;
  /** The kind of the work, so that the level narrows with the first one. */
  type: string;
  /** How many chapters the work has. */
  count: number;
};

type Props = {
  /** The kinds of work that occur, with the kinds that do not occur left out. */
  types: TypeOption[];
  /** The series — few, and always on screen. */
  series: WorkOption[];
  /**
   * The stand-alone works — many, and each one carries its whole title.
   *
   * They are kept behind a button rather than spread over the width of
   * the page: a row of twelve full titles is a wall of text that says
   * less than the list of works below it does.
   */
  standalone: WorkOption[];
  /**
   * The tags that are neither a kind nor a work — the free-form ones.
   */
  tags: { slug: string; name: string; count: number }[];
};
const { types, series, standalone, tags } = Astro.props;

const t = useTranslations(config.site.uiLang);

/**
 * The label of the button that opens the rest of the works.
 *
 * The count is part of the label, because a button that hides twelve
 * things should say so: the reader knows what is behind it before
 * pressing it.
 */
const moreWorksLabel = t.writing.moreWorks.replace(
  "{{0}}",
  String(standalone.length)
);

/**
 * The dictionary key of each kind of work.
 *
 * The label of a kind is part of the interface rather than part of the
 * content, so it has to be marked for translation: the button says
 * "随笔" in Chinese and "Essay" in English, and the kind is the same
 * either way.
 */
const TYPE_I18N_KEYS: Record<string, string> = {
  novel: "writing.novel",
  essay: "writing.essay",
  review: "writing.review",
  character: "writing.character",
  short: "writing.short",
};
---

{
  /*
  The filter of the writing page.

  The writing collection is not a bag of tagged items like the rest of the
  site: a piece of writing is a novel, an essay, a review or a short
  story, and it belongs to a series or it stands on its own. So the filter
  is built the way the collection actually is — in levels — rather than as
  one flat row of tags.

  The three levels are:

    1. the kind of the work — 原创小说 / 随笔 / 观后感 / 短篇;
    2. the work itself — a series by name, or a stand-alone piece;
    3. the free-form tags — the ones that cut across kinds ("玄幻",
       "恐怖片").

  The levels narrow each other: choosing a kind narrows the works below it
  to that kind, and choosing a work narrows the tags to the ones that
  work carries. The reader is never asked to pick a combination that does
  not exist.
*/
}
<div class="app-writing-filter" data-writing-filter>
  <div class="app-writing-filter-level">
    <span class="app-writing-filter-label" data-i18n="writing.byType">
      {t.writing.byType}
    </span>
    <div class="app-writing-filter-options">
      <button
        type="button"
        class="app-writing-filter-option app-writing-filter-option-strong"
        data-writing-facet="type"
        data-writing-value=""
        data-i18n="writing.all"
        aria-pressed="true"
      >
        {t.writing.all}
      </button>
      {
        types.map(option => (
          <button
            type="button"
            class="app-writing-filter-option app-writing-filter-option-strong"
            data-writing-facet="type"
            data-writing-value={option.value}
            data-i18n={TYPE_I18N_KEYS[option.value]}
            aria-pressed="false"
          >
            {option.label}
            <span class="app-writing-filter-count">{option.count}</span>
          </button>
        ))
      }
    </div>
  </div>

  {
    /*
      The works.

      The series and the stand-alone works are one level, not two: they
      are both "a work", and two levels that carry the same label are
      two labels that say the same thing.

      The series are always on screen — a series is a thing with
      chapters, and it is what a reader most often comes for. The
      stand-alone works are a dozen full titles, and a row of them is a
      wall of text that says less than the list of works below the filter
      does. So they sit behind a button that says how many are waiting.

      The works are in the markup either way — the button only folds them
      away — so that the filter can still match on a work whose name the
      reader has not seen yet.
    */
    (series.length > 0 || standalone.length > 0) && (
      <div class="app-writing-filter-level">
        <span class="app-writing-filter-label" data-i18n="writing.byWork">
          {t.writing.byWork}
        </span>
        <div class="app-writing-filter-options">
          <button
            type="button"
            class="app-writing-filter-option"
            data-writing-facet="work"
            data-writing-value=""
            data-i18n="writing.allWorks"
            aria-pressed="true"
          >
            {t.writing.allWorks}
          </button>
          {series.map(work => (
            <button
              type="button"
              class="app-writing-filter-option"
              data-writing-facet="work"
              data-writing-value={work.value}
              data-writing-work-type={work.type}
              aria-pressed="false"
            >
              {work.label}
              {work.count > 1 && (
                <span class="app-writing-filter-count">{work.count}</span>
              )}
            </button>
          ))}
          {standalone.length > 0 && (
            <button
              type="button"
              class="app-writing-filter-more"
              data-writing-more
              aria-expanded="false"
              aria-controls="writing-standalone-works"
              data-i18n="writing.moreWorks"
              data-i18n-args={String(standalone.length)}
            >
              {moreWorksLabel}
            </button>
          )}
        </div>
        {standalone.length > 0 && (
          <div
            class="app-writing-filter-folded"
            id="writing-standalone-works"
            data-writing-folded
            hidden
          >
            {standalone.map(work => (
              <button
                type="button"
                class="app-writing-filter-option"
                data-writing-facet="work"
                data-writing-value={work.value}
                data-writing-work-type={work.type}
                aria-pressed="false"
              >
                {work.label}
              </button>
            ))}
          </div>
        )}
      </div>
    )
  }

  {
    tags.length > 0 && (
      <div class="app-writing-filter-level">
        <span class="app-writing-filter-label" data-i18n="tags.title">
          {t.tags.title}
        </span>
        {/*
          The free-form tags keep the ordinary chip behaviour, so that the
          same tag means the same thing here as it does on the search page.
        */}
        <div
          class="app-writing-filter-options"
          data-tag-bar
          data-tag-mode="filter"
        >
          <button
            type="button"
            class="app-writing-filter-option"
            data-tag-chip=""
            data-tag-mode="filter"
            aria-pressed="true"
          >
            {t.tags.all}
          </button>
          {tags.map(tag => (
            <button
              type="button"
              class="app-writing-filter-option"
              data-tag-chip={tag.slug}
              data-tag-mode="filter"
              aria-pressed="false"
              title={`#${tag.name}`}
            >
              {tag.name}
              <span class="app-writing-filter-count">{tag.count}</span>
            </button>
          ))}
        </div>
      </div>
    )
  }
</div>
