---
import type { CollectionEntry } from "astro:content";
import { getWritingUrl } from "@/utils/getPostPaths";
import { tagSlug, tagDisplayName } from "@/utils/tagIndex";
import Datetime from "./Datetime.astro";
import TagChip from "./TagChip.astro";

type Props = {
  work: CollectionEntry<"writing">;
  /**
   * Which shape of the entry to render.
   *
   * The *listing* shape carries the summary; it is used on the writing
   * page, where the entry is the subject.
   *
   * The *compact* shape is used on the home page, where the section is a
   * reference to the works rather than an introduction to them: the title
   * comes first, then the date, then the tags.
   */
  variant?: "listing" | "compact";
};

const { work, variant = "listing" } = Astro.props;
const { data } = work;

const href = getWritingUrl(data.slug, Astro.currentLocale);

const tags = data.tags ?? [];
const tagSlugs = tags.map(tagSlug);
---

<li class="app-list-entry" data-tagged-item data-tags={tagSlugs.join(",")}>
  {
    variant === "compact" ? (
      <article class="flex flex-col gap-1.5">
        <h2 class="text-lg leading-snug font-semibold">
          <a
            href={href}
            class="text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            {data.title}
          </a>
        </h2>

        {/*
        The line the work gives about itself.

        It was left out when the section was a narrow strip of titles, but
        a work with nothing under its title is a title and nothing else.
        The line is what makes the section read as a shelf of works rather
        than as a list of links.
        */}
        {data.description && (
          <p class="text-muted-foreground line-clamp-2 text-[0.8125rem] leading-relaxed">
            {data.description}
          </p>
        )}

        <div class="app-vertical-date">
          <Datetime pubDatetime={data.pubDatetime} bare compact />
        </div>

        {tags.length > 0 && (
          <ul class="mt-0.5 flex flex-wrap gap-1.5">
            {tags.map(tag => (
              <li>
                <TagChip
                  slug={tagSlug(tag)}
                  name={tagDisplayName(tag)}
                  mode="static"
                  size="sm"
                />
              </li>
            ))}
          </ul>
        )}
      </article>
    ) : (
      <article class="flex flex-col gap-2">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h2 class="text-lg font-semibold">
            <a
              href={href}
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              {data.title}
            </a>
          </h2>
          {/*
            Neither the chapter number nor the status is shown here.

            The chapter number repeated what the title already said — a
            work titled "第二天：微小的步伐" does not also need to be
            labelled "第 2" — and the status is a fact about the whole
            series, which the heading above the list already carries.
          */}
        </div>
        {data.description && <p>{data.description}</p>}
        <div class="text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
          <Datetime pubDatetime={data.pubDatetime} />
        </div>
        {tags.length > 0 && (
          <ul class="mt-1 flex flex-wrap gap-2">
            {tags.map(tag => (
              <li>
                <TagChip
                  slug={tagSlug(tag)}
                  name={tagDisplayName(tag)}
                  mode="static"
                  size="sm"
                />
              </li>
            ))}
          </ul>
        )}
      </article>
    )
  }
</li>
