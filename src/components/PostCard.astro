---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { tagSlug, tagDisplayName } from "@/utils/tagIndex";
import Datetime from "./Datetime.astro";
import TagChip from "./TagChip.astro";

/**
 * A technical article in the vertical list.
 *
 * Every article is one self-contained block, and the blocks are stacked
 * vertically down the page. Inside a block the elements also run top to
 * bottom — the date, then the title, then the summary, then the tags — so
 * the eye travels straight down the column instead of zig-zagging between
 * a left-hand date gutter and a right-hand body.
 *
 * The date sits above the title rather than beside it, which is what keeps
 * the block readable as a single unit: the title is the first thing the
 * eye lands on, and the timestamp is the quiet line above it.
 */
type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { data, id, filePath } = post;

const href = getPostUrl(id, filePath, Astro.currentLocale);
const tags = data.tags ?? [];
const tagSlugs = tags.map(tagSlug);
---

<li data-tagged-item data-tags={tagSlugs.join(",")}>
  <article class="flex flex-col gap-2.5">
    <div class="app-vertical-date">
      <Datetime
        pubDatetime={data.pubDatetime}
        modDatetime={data.modDatetime ?? null}
        bare
        compact
      />
    </div>

    <a
      href={href}
      class="text-accent inline-block text-xl leading-snug font-semibold decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
    >
      <h2 transition:name={toTransitionName(id)}>{data.title}</h2>
    </a>

    {
      data.description && (
        <p class="text-muted-foreground text-[0.9375rem] leading-relaxed">
          {data.description}
        </p>
      )
    }

    {
      tags.length > 0 && (
        <ul class="mt-0.5 flex flex-wrap gap-1.5">
          {tags.map(tag => (
            <li>
              <TagChip
                slug={tagSlug(tag)}
                name={tagDisplayName(tag)}
                mode="static"
                size="sm"
              />
            </li>
          ))}
        </ul>
      )
    }
  </article>
</li>
