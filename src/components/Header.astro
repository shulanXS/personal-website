---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import MonogramLogo from "@/assets/monogram-logo.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;

// The interface language is independent from the Astro i18n locale.
const uiLang = site.uiLang;
const t = useTranslations(uiLang);

/*
 * The name of the site is deliberately language-independent: it is always
 * rendered in Latin letters ("Wenjie Che"), in the Chinese interface too.
 * A name is not a phrase — translating it would make it look like an alias.
 */
const siteTitle = t.site.title;

// The toggle switches to the other available language.
const nextLang = uiLang === "zh-CN" ? "en" : "zh-CN";
const nextLangLabel = t.a11y.langName[nextLang] ?? nextLang;

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-header-bar sticky top-0 z-40 w-full">
  {
    /*
    The bar reaches the full width of the viewport, so that the page scrolls
    visibly *under* it and the bar reads as a band of light rather than as a
    panel floating in the middle of the screen.

    Its *contents* are aligned with the chrome column — a width that is the
    same on every single page, independent of how wide the page body
    happens to be. The navigation therefore looks identical on the home
    page, on a listing page and on an article.
    */
  }
  <div
    class="app-chrome grid grid-cols-[1fr_auto] items-center gap-x-3 gap-y-2 py-3 sm:gap-x-4 sm:py-4 lg:grid-cols-[auto_1fr_auto] lg:py-5"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="app-header-brand relative col-start-1 row-start-1 flex items-center gap-2.5 py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:my-auto sm:text-2xl sm:leading-none"
    >
      <MonogramLogo
        class="text-foreground size-7 shrink-0 sm:size-8"
        aria-hidden="true"
      />
      <span data-i18n="site.title">{siteTitle}</span>
    </a>

    {
      /*
      The three icon-only controls.

      They sit next to the brand on a narrow screen — on the right of the
      first row — and on the far right of the bar on a wide one.
      */
    }
    <div
      id="nav-controls"
      class="col-start-2 row-start-1 flex items-center justify-end gap-0.5 lg:col-start-3 lg:row-start-1 lg:gap-5"
    >
      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class:list={["focus-outline relative size-8"]}
            title={t.nav.search}
            aria-label={t.nav.search}
            data-i18n="nav.search"
            data-i18n-attr="aria-label"
          >
            <IconSearch class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2" />
            <span class="sr-only" data-i18n="nav.search">
              {t.nav.search}
            </span>
            {isActive("/search") && (
              <IconUnderline
                aria-hidden="true"
                class="absolute bottom-0 w-6 scale-125 max-sm:inset-s-2"
              />
            )}
          </LinkButton>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline hover:[&>svg]:stroke-foreground relative size-8 p-1.5 lg:size-8"
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.toggleTheme}
            data-i18n="a11y.toggleTheme"
            data-i18n-attr="title,aria-label"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
      {
        /*
        The button shows the language it switches *to*. The target is
        recomputed at runtime whenever the active language changes — a
        server-rendered target would stay frozen and make it impossible to
        switch back.
      */
      }
      <button
        id="lang-btn"
        class="focus-outline hover:text-foreground flex size-8 items-center justify-center text-sm font-medium"
        title={t.a11y.switchLanguage}
        aria-label={t.a11y.switchLanguage}
        data-i18n="a11y.switchLanguage"
        data-i18n-attr="title,aria-label"
        data-lang-target={nextLang}
      >
        <span data-lang-label-text>{nextLangLabel}</span>
      </button>
    </div>

    {
      /*
      The navigation.

      The links are *always* visible — there is no burger button. A
      visitor on a phone has to be able to reach every section of the site
      without opening a menu first: a hidden menu hides the site, and the
      visitor who never opens it concludes that the site has four pages.

      On a narrow screen the links take a row of their own, below the
      brand. They are set in the small size and wrap onto a second line
      when the labels do not fit, so that no link is ever cut off.

      On a wide screen the links move back into the bar itself, between
      the brand and the controls.
      */
    }
    <ul
      id="menu-items"
      class="col-start-1 col-end-3 row-start-2 flex flex-wrap items-center gap-x-0.5 gap-y-1 lg:col-start-2 lg:col-end-3 lg:row-start-1 lg:flex-nowrap lg:justify-end lg:gap-x-2"
    >
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="block px-2 py-1.5 text-center text-[0.9375rem] whitespace-nowrap lg:py-1"
          class:list={{ "active-nav": isActive("/posts") }}
        >
          <span data-i18n="nav.posts">{t.nav.posts}</span>
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "notes")}
          class="block px-2 py-1.5 text-center text-[0.9375rem] whitespace-nowrap lg:py-1"
          class:list={{ "active-nav": isActive("/notes") }}
        >
          <span data-i18n="nav.notes">{t.nav.notes}</span>
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "writing")}
          class="block px-2 py-1.5 text-center text-[0.9375rem] whitespace-nowrap lg:py-1"
          class:list={{ "active-nav": isActive("/writing") }}
        >
          <span data-i18n="nav.writing">{t.nav.writing}</span>
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class="block px-2 py-1.5 text-center text-[0.9375rem] whitespace-nowrap lg:py-1"
          class:list={{ "active-nav": isActive("/projects") }}
        >
          <span data-i18n="nav.projects">{t.nav.projects}</span>
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="block px-2 py-1.5 text-center text-[0.9375rem] whitespace-nowrap lg:py-1"
          class:list={{ "active-nav": isActive("/about") }}
        >
          <span data-i18n="nav.about">{t.nav.about}</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  import { flatRuntimeTranslations } from "@/i18n";

  function currentLang(): string {
    try {
      const stored = localStorage.getItem("uiLang");
      if (stored && stored in flatRuntimeTranslations) return stored;
    } catch {
      // localStorage unavailable — fall back to the server-rendered label.
    }
    const injected = (window as unknown as { __uiLang?: string }).__uiLang;
    if (injected && injected in flatRuntimeTranslations) return injected;
    return "";
  }

  function labelFor(key: string, fallback: string): string {
    const dict = flatRuntimeTranslations[currentLang()];
    return dict?.[key] ?? fallback;
  }

  /*
   * The language button shows the language it switches *to*.
   *
   * The label is rewritten whenever the active language changes, so that
   * the button always offers the other language and never the one that is
   * already in use.
   */
  function refreshLangLabel() {
    const langBtn = document.querySelector<HTMLButtonElement>("#lang-btn");
    if (!langBtn) return;

    const target = langBtn.dataset.langTarget;
    if (!target) return;

    const label = labelFor(`a11y.langName.${target}`, target);
    const labelNode = langBtn.querySelector<HTMLElement>(
      "[data-lang-label-text]"
    );
    if (labelNode) labelNode.textContent = label;
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  refreshLangLabel();
  document.addEventListener("ui:langchange", refreshLangLabel);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
