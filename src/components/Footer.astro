---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import MonogramLogo from "@/assets/monogram-logo.svg";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(config.site.uiLang);
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  class:list={["w-full", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  {
    /*
    The rule and the contents of the footer are aligned with the chrome
    column, so that the footer begins on the same vertical line as the
    navigation above it — on every page, whatever the width of the page
    body happens to be.
    */
  }
  <div class="app-chrome border-border border-t">
    {
      /*
      The footer is one centred column of three lines:

        1. the brand — the mark, the name and the way to reach the author;
        2. one sentence about the site;
        3. the legal line.

      Everything is centred on every screen. A footer split into columns
      gives the eye three things to read at once and pulls the attention
      away from the page above; one centred stack reads as a single quiet
      sign-off at the end of the page.
      */
    }
    <div class="flex flex-col items-center gap-6 py-10 sm:py-12">
      {
        /*
        The brand line.

        The mark and the name are the same object — the mark is a monogram
        of the name — so they sit together on one line, and the circular
        social buttons follow them, separated by a hair's breadth more.
        */
      }
      <div class="flex flex-col items-center gap-5 sm:flex-row sm:gap-6">
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class="app-header-brand flex items-center gap-2.5 text-lg font-semibold whitespace-nowrap"
        >
          <MonogramLogo
            class="text-foreground size-8 shrink-0"
            aria-hidden="true"
          />
          <span data-i18n="site.title">{t.site.title}</span>
        </a>

        <Socials align="center" size="sm" />
      </div>

      {
        /*
        The description.

        The width is capped, so that the sentence keeps a comfortable
        measure on a wide screen instead of stretching into a thin line of
        text across the whole viewport.
        */
      }
      <p
        class="text-muted-foreground max-w-md text-center text-sm leading-relaxed"
        data-i18n="site.description"
      >
        {t.site.description}
      </p>

      {
        /*
        The legal line.

        The year and the name are rendered by the server, so they never go
        stale. Only the last phrase is translated.
        */
      }
      <p class="text-muted-foreground text-center text-xs sm:text-sm">
        &#169; {currentYear}
        <span data-i18n="site.author">{t.site.author}</span>
        <span aria-hidden="true">&nbsp;·&nbsp;</span>
        <span data-i18n="footer.allRightsReserved">
          {t.footer.allRightsReserved}
        </span>
      </p>
    </div>
  </div>
</footer>
