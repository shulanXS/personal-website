---
import { routeUrl } from "@/utils/routes";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  /** Translation key of the page title, enables live language switching. */
  titleKey?: string;
  /** Translation key of the page description. */
  descKey?: string;
};

const {
  pageTitle,
  pageDesc,
  class: className,
  titleKey,
  descKey,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : routeUrl(locale, "home");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <h1 class="text-2xl font-semibold sm:text-3xl" data-i18n={titleKey}>
    {pageTitle}
  </h1>
  {
    pageDesc && (
      <p class="mt-2 mb-6 italic" data-i18n={descKey}>
        {pageDesc}
      </p>
    )
  }
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
