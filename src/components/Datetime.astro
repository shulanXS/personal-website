---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import {
  formatDate,
  formatCompactDate,
  formatStackedDate,
} from "@/utils/formatDate";
dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  /**
   * Render the date on its own, without the calendar icon.
   *
   * On the notes timeline the date sits in a narrow column next to the
   * vertical rule, where an icon would take up more room than the text
   * itself.
   */
  bare?: boolean;
  /**
   * Use the short numeric layout instead of the full one.
   *
   * The timeline column is only a few characters wide, so the long
   * "2026年6月3日 14:05" would wrap.
   */
  compact?: boolean;
  /**
   * Split the compact date into two lines: the day on top, the time
   * underneath it.
   *
   * The timeline column is narrower than a full timestamp, so the date and
   * the time cannot share one line — the overflow crossed the vertical rule
   * and ran into the entry beside it. Two lines keep the column exactly as
   * wide as the day itself.
   *
   * The two lines live in two separate elements, so the client-side
   * language switch can rewrite them independently.
   */
  stacked?: boolean;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  bare = false,
  compact = false,
  stacked = false,
} = Astro.props;

const t = useTranslations(config.site.uiLang);

const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  postTimezone ?? config.site.timezone
);

const stamp = isModified ? modDatetime : pubDatetime;

/*
 * The month name follows the interface language, so the Chinese UI shows
 * "9 10月 2025" instead of the English "9 Oct, 2025".
 *
 * The three layouts are kept apart rather than merged into one variable:
 * the stacked one has two parts instead of one string, and the type of the
 * union would hide that from the template.
 */
const stackedDate = stacked
  ? formatStackedDate(
      stamp,
      config.site.uiLang,
      postTimezone ?? config.site.timezone
    )
  : null;

const date = stacked
  ? ""
  : compact
    ? formatCompactDate(
        stamp,
        config.site.uiLang,
        postTimezone ?? config.site.timezone
      )
    : formatDate(
        stamp,
        config.site.uiLang,
        postTimezone ?? config.site.timezone
      );
---

<div
  class:list={[
    "text-muted-foreground",
    /*
      The stacked layout runs the day and the moment of the day down a
      single column instead of across a row, so that the pair stays as
      narrow as the day alone.
    */
    stacked ? "app-timeline-stacked" : "flex items-center gap-x-2",
    className,
  ]}
>
  {
    !bare && (
      <IconCalendar
        class:list={[
          "inline-block size-6 min-w-5.5",
          { "scale-90": size === "sm" },
        ]}
      />
    )
  }
  {
    isModified && (
      <>
        {/*
          The colon lives outside the translated span, otherwise replacing the
          label would also remove the punctuation.
        */}
        <span
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
          data-i18n="post.updatedAt"
        >
          {t.post.updatedAt}
        </span>
        <span
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
          aria-hidden="true"
        >
          :
        </span>
      </>
    )
  }
  {
    /*
      The stacked layout puts the day and the moment of the day into two
      elements of their own, so that the client-side language switch can
      rewrite each of them separately.
    */
    stacked && stackedDate ? (
      <>
        <time
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
          datetime={datetime.toISOString()}
          data-date-stacked={datetime.toISOString()}
        >
          {stackedDate.date}
        </time>
        <time
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
          datetime={datetime.toISOString()}
          data-date-stacked-time={datetime.toISOString()}
        >
          {stackedDate.time}
        </time>
      </>
    ) : (
      <time
        class:list={["text-sm", { "sm:text-base": size === "lg" }]}
        datetime={datetime.toISOString()}
        data-date={compact ? undefined : datetime.toISOString()}
        data-date-compact={compact ? datetime.toISOString() : undefined}
      >
        {date}
      </time>
    )
  }
</div>
