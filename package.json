{
  "name": "astro-paper-v6",
  "type": "module",
  "version": "7.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run redirects:write && astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/ && npm run redirects:audit",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "redirects:write": "node scripts/redirects.mjs --write",
    "redirects:audit": "node scripts/redirects.mjs --audit",
    "audit:static": "node --experimental-strip-types scripts/audit.mjs",
    "audit:regression": "node scripts/regression.mjs",
    "audit:tags": "node scripts/tag-audit.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:layout": "node scripts/layout-audit.mjs",
    "audit:writing": "node scripts/writing-audit.mjs",
    "font:reading": "node scripts/build-reading-font.mjs",
    "covers:build": "node scripts/build-covers.mjs",
    "image:prepare": "node scripts/prepare-image.mjs",
    "image:upload": "node scripts/upload-image.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.7",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.10",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@pagefind/default-ui": "^1.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^2.1.1",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
